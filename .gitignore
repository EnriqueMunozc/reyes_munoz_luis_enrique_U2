# Laravel / PHP
/vendor/
/node_modules/
/public/build/
/public/hot
/public/storage
/storage/*.key
/storage/app/*
!/storage/app/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Environment and secrets
.env
.env.*
!.env.example
# Docker local configuration generated by scripts/prepare-docker.ps1
.env.docker
*.pem
*.key
*.crt

# Databases and local dumps
*.sqlite
*.sqlite3
*.bak
*.bacpac
*.mdf
*.ldf
*.ndf
*.sql

# Dependency and build outputs
/dist/
/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini

# Tests and coverage
/coverage/
.phpunit.result.cache
